# ぶれない設定（README の「ぶれない設定」）。docker compose の lab-stable が読み込む
# 手元で使うときは: uv run --env-file stable.env bench.py async --repeat 3

# プールを常駐 15 本に固定する。既定（常駐 5 + 追加 10）は、追加分の接続が途中で閉じられて実質のプールが縮むことがある
POOL_SIZE=15
MAX_OVERFLOW=0

# 締め切りを 5 秒ごとの区切りからずらす。区切りとちょうど重なると、最後の 1 回分が間に合うかどうかがその時々で変わる
# D は 28 秒で 6 回分（90 件）、B と C は 62 秒で 12 回分（12 件・180 件）
POOL_TIMEOUT=28
HEY_TIMEOUT=62

# 既定の設定の結果と混ざらないように分けて保存する
RESULTS_DIR=results/stable
